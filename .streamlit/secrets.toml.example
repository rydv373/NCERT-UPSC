# Copy this file to secrets.toml (same directory) and fill in your Supabase project's values
# from Project Settings -> API. secrets.toml itself is gitignored — never commit real keys.
#
# Use the "anon" public key here, NOT service_role (service_role is only for
# scripts/05_migrate_to_supabase.py, run locally via env vars, never put it in this file).

SUPABASE_URL = "https://xxxxx.supabase.co"
SUPABASE_ANON_KEY = "eyJ..."
